# =============================================================================
# .gitignore — Universal Autonomous AI Testing Platform
# =============================================================================

# ── Secrets & Environment Configuration — NEVER commit these ────────────────
.env
.env.local
.env.*.local
*.pem
*.key
*.p12
*.pfx
/secrets/
/.secrets/
# Keep documented safe environment examples
!.env.example

# ── Python & Bytecode ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/
.venv*/
venv*/
pip-log.txt
pip-delete-this-directory.txt

# Testing & Coverage
.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
.hypothesis/

# Type-checking & Linting caches
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/

# Local databases & caches
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.rdb

# ── Node / TypeScript / Frontend ──────────────────────────────────────────────
node_modules/
.npm/
.pnp
.pnp.js
.eslintcache

# Build output & caches
dist/
frontend/dist/
.vite/
frontend/.vite/
coverage/
frontend/coverage/
*.tsbuildinfo

# Generated TypeScript types backup files
*.openapi-ts.bak

# ── Runtime & Test Artifacts ──────────────────────────────────────────────────
# Anchor root artifacts directories so packages (e.g. backend/packages/evidence) are NOT ignored
/artifacts/
/evidence/
/output/
output/
/tests/artifacts/
/tests/evidence/
/tests/output/
/playwright-report/
/test-results/
/blob-report/
/.playwright/
/ms-playwright/

# Temporary scratch & debug scripts
/scratch/
scratch/
*.scratch.*
check_db.py
fix_dag_steps.py
test_live_run.py
temp_*
tmp_*
*.tmp
*.bak

# AI agent caches & scratchpads
.agent/
.agents/
.gemini/
.antigravity/
brain/

# Binary test outputs
*.png
*.jpg
*.jpeg
*.zip
*.tar.gz
*.har
*.webm

# Explicitly preserve required test fixtures
!tests/fixtures/**/*.png
!tests/fixtures/**/*.jpg
!tests/fixtures/**/*.json

# ── Docker & Local Infrastructure ─────────────────────────────────────────────
/.docker-volumes/
/postgres-data/
/redis-data/

# ── IDEs, Editors & OS Files ──────────────────────────────────────────────────
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
/logs/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
