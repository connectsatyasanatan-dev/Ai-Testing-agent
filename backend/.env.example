# =============================================================================
# backend/.env.example  →  copy to .env at repo root for local development.
# NEVER commit .env — it is in .gitignore.
# All vars require the UITP_ prefix (enforced by pydantic-settings).
# =============================================================================

# ── Application ───────────────────────────────────────────────────────────────
UITP_APP_ENV=development
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
UITP_SECRET_KEY=replace-with-a-real-secret-key-before-use
UITP_BASE_URL=http://localhost:8000

# ── Database ──────────────────────────────────────────────────────────────────
# Matches docker-compose.yml defaults (PostgreSQL container).
UITP_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/uitp_dev

# For a local SQLite prototype only (not recommended for team use):
# UITP_DATABASE_URL=sqlite+aiosqlite:///./local.db

# ── Artifact storage (Milestone 1: local filesystem) ─────────────────────────
UITP_ARTIFACT_STORAGE_PATH=./artifacts

# ── Queue (Milestone 2 only — leave commented for Milestone 1) ───────────────
UITP_REDIS_URL=redis://localhost:6379/0

# ── CORS ──────────────────────────────────────────────────────────────────────
UITP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Rate limiting ─────────────────────────────────────────────────────────────
UITP_RATE_LIMIT_LOGIN=10
UITP_RATE_LIMIT_RUN_CREATE=30

# ── AI provider (optional — leave unset for manual plan authoring only) ───────
# When unset, POST /api/v1/projects/{id}/plans/generate returns 503.
# UITP_AI_PROVIDER=openai
# UITP_AI_API_KEY=replace-with-real-key
# UITP_AI_MODEL=gpt-4o
# UITP_AI_MAX_TOKENS=2048
# UITP_AI_TIMEOUT_SECONDS=30
# UITP_AI_MONTHLY_BUDGET_USD=10.00

# ── Logging ───────────────────────────────────────────────────────────────────
UITP_LOG_LEVEL=INFO
UITP_LOG_FORMAT=text
